# Postgres
POSTGRES_USER=stu_dent
POSTGRES_PASSWORD=stu_dent
POSTGRES_DB=stu_dent

# Backend
DATABASE_URL=postgresql+psycopg://stu_dent:stu_dent@db:5432/stu_dent
# Optional: overrides which database `pytest` builds its schema against and
# runs against (backend/tests/conftest.py). Defaults to DATABASE_URL's own
# host/creds with the DB name swapped to "..._test" if unset -- only needed
# if you want the test DB somewhere other than that computed default.
# TEST_DATABASE_URL=postgresql+psycopg://stu_dent:stu_dent@db:5432/stu_dent_test
JWT_SECRET_KEY=change-me-please-generate-a-random-secret
JWT_ALGORITHM=HS256
# 30 minutes (the old default) is shorter than a typical clinic shift, so a
# student mid-appointment would silently get logged out; 2 hours balances
# session length against not adding refresh-token machinery. The frontend
# handles an expired token gracefully regardless (see httpClient.ts).
JWT_EXPIRE_MINUTES=120
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS=10
REGISTRATION_RATE_LIMIT_WINDOW_MINUTES=15
REGISTRATION_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=50
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_MINUTES=15
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=50
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM=noreply@stu-dent.local
REMINDER_LEAD_HOURS=24
JOB_POLL_INTERVAL_SECONDS=300
UNRESOLVED_APPOINTMENT_GRACE_HOURS=24
FEEDBACK_REMINDER_GRACE_HOURS=24
FRONTEND_ORIGINS=http://localhost:5173
# Public browser-facing origins used for OAuth redirects. These are not
# Docker service names. Register the callback URLs documented in README.md
# with each provider, and change both values to the real HTTPS origins in
# production.
OAUTH_BACKEND_PUBLIC_URL=http://localhost:8000
OAUTH_FRONTEND_URL=http://localhost:5173
# Google Cloud OAuth 2.0 Web application credentials. Keep real values in
# the git-ignored .env file; Compose loads it after this defaults file.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Apple Developer Sign in with Apple Services ID + private key. Keep the
# .p8 key on one line with literal \n characters between its original lines.
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
# Seeds idempotent demo data automatically on first `docker compose up`
# (see docker-compose.yml's seed-init service). Set to false for a
# genuinely empty DB -- e.g. real testing, or a from-scratch course
# submission run.
SEED_DEMO_ON_START=true

# Frontend
VITE_API_URL=http://localhost:8000
